<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" source="c2" target="d" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="reconexión" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;" edge="1" source="d" target="e" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="cuando el nodo vuelve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;" edge="1" source="e" target="f" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" source="f" target="g" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="leyenda" value="Resultados de 3 ensayos con caída abrupta y un escritor continuo: RTO de escritura 30,0 · 36,4 · 35,8 s; RPO 0 (178 de 178, 205 de 205 y 214 de 214 escrituras confirmadas halladas en la nueva primaria); promoción ≈ 2,5 s. La detección domina el RTO.&lt;br&gt;Límite honesto: la replicación es asíncrona, así que RPO 0 no está garantizado en general (una caída entre la confirmación y el envío del WAL puede perder las últimas transacciones). La promoción es guionizada, no automática. No hay fail-back: los roles quedan intercambiados." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5A626E;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="1270" height="60" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
