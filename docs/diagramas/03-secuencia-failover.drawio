<mxfile host="app.diagrams.net"><diagram name="Secuencia failover" id="failover"><mxGraphModel adaptiveColors="auto" dx="1300" dy="800" grid="1" gridSize="10" page="1" pageWidth="1350" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Secuencia de failover — caída abrupta de la primaria de PostgreSQL (tiempos medidos)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1100" height="30" as="geometry"/></mxCell>
<mxCell id="l1" value="Nodo caído (era la primaria)" style="swimlane;horizontal=0;startSize=110;html=1;fontSize=12;whiteSpace=wrap;fillColor=#FDF3F3;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1270" height="120" as="geometry"/></mxCell>
<mxCell id="l2" value="Monitoreo (Prometheus y Alertmanager)" style="swimlane;horizontal=0;startSize=110;html=1;fontSize=12;whiteSpace=wrap;fillColor=#FFFAF0;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="1270" height="120" as="geometry"/></mxCell>
<mxCell id="l3" value="Operador (scripts de infra/failover)" style="swimlane;horizontal=0;startSize=110;html=1;fontSize=12;whiteSpace=wrap;fillColor=#F7F8FA;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="1270" height="120" as="geometry"/></mxCell>
<mxCell id="l4" value="Nodo standby (pasa a primaria)" style="swimlane;horizontal=0;startSize=110;html=1;fontSize=12;whiteSpace=wrap;fillColor=#F3FAF5;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="1270" height="120" as="geometry"/></mxCell>
<mxCell id="l5" value="Aplicación (backends y balanceador)" style="swimlane;horizontal=0;startSize=110;html=1;fontSize=12;whiteSpace=wrap;fillColor=#F6F9FF;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="1270" height="120" as="geometry"/></mxCell>
<mxCell id="a" value="&lt;b&gt;T0 · cae la primaria&lt;/b&gt;&lt;br&gt;docker kill, con un escritor confirmando ~10 inserciones/s" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="l1"><mxGeometry x="130" y="20" width="165" height="80" as="geometry"/></mxCell>
<mxCell id="b" value="&lt;b&gt;T0 + 27–34 s&lt;/b&gt;&lt;br&gt;Alerta PostgresCaido (for 20 s)&lt;br&gt;= 85–90 % del RTO" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF6E0;strokeColor=#E8C36A;" vertex="1" parent="l2"><mxGeometry x="315" y="20" width="165" height="80" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;aislar.sh · fencing&lt;/b&gt;&lt;br&gt;restart=no + stop en el nodo caído (evita split-brain)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="l3"><mxGeometry x="500" y="20" width="165" height="80" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;promover.sh&lt;/b&gt;&lt;br&gt;comprobaciones, pg_promote y CHECKPOINT&lt;br&gt;≈ 2,5 s" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="l3"><mxGeometry x="685" y="20" width="165" height="80" as="geometry"/></mxCell>
<mxCell id="d" value="&lt;b&gt;Nueva primaria&lt;/b&gt;&lt;br&gt;nueva línea de tiempo&lt;br&gt;RPO 0 en los 3 ensayos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="l4"><mxGeometry x="685" y="20" width="165" height="80" as="geometry"/></mxCell>
<mxCell id="e" value="&lt;b&gt;Los backends reconectan solos&lt;/b&gt;&lt;br&gt;JDBC multi-host, targetServerType=primary&lt;br&gt;RTO de escritura 30–36 s" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="l5"><mxGeometry x="870" y="20" width="165" height="80" as="geometry"/></mxCell>
<mxCell id="h" value="&lt;b&gt;Balanceador y sondas&lt;/b&gt;&lt;br&gt;13–18 de ~70 sondas distintas de 200 durante la ventana" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="l5"><mxGeometry x="500" y="20" width="165" height="80" as="geometry"/></mxCell>
<mxCell id="f" value="&lt;b&gt;reincorporar.sh&lt;/b&gt;&lt;br&gt;pg_rewind 12 s, o reconstrucción ≈ 10 s si falla" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="l3"><mxGeometry x="1055" y="20" width="165" height="80" as="geometry"/></mxCell>
<mxCell id="g" value="&lt;b&gt;Vuelve como standby&lt;/b&gt;&lt;br&gt;streaming, retraso 0&lt;br&gt;sin fail-back automático" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="l1"><mxGeometry x="1055" y="20" width="165" height="80" as="geometry"/></mxCell>
<mxCell id="e1" value="detección" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;" edge="1" source="a" target="b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="alerta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;" edge="1" source="b" target="c1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
